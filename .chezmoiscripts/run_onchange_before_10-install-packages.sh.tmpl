{{ if and (eq .chezmoi.os "linux") (lookPath "apt-get") -}}
#!/usr/bin/env bash
# Install apt packages. Re-runs whenever this list changes; only calls sudo
# when something is actually missing.
set -euo pipefail

packages=(
  zsh git git-lfs curl wget unzip make jq
  ripgrep fd-find fzf bat eza btop neovim build-essential zoxide
)

missing=()
for p in "${packages[@]}"; do
  dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p")
done

if (( ${#missing[@]} )); then
  sudo apt-get update -qq
  # Older distros (e.g. Debian bookworm in dev containers) lack some packages,
  # like eza; skip those here and let the tools script fetch them.
  available=()
  for p in "${missing[@]}"; do
    if apt-cache show "$p" >/dev/null 2>&1; then available+=("$p"); else echo "Skipping $p (not in apt)"; fi
  done
  if (( ${#available[@]} )); then
    echo "Installing apt packages: ${available[*]}"
    sudo apt-get install -y -qq "${available[@]}"
  fi
fi
{{ else if and (eq .chezmoi.os "darwin") (lookPath "brew") -}}
#!/usr/bin/env bash
# Install Homebrew packages (covers what the Linux tools script fetches from
# GitHub, too). Re-runs whenever this list changes; only calls brew when
# something is actually missing.
set -euo pipefail

packages=(
  git-lfs jq ripgrep fd fzf bat eza btop neovim
  starship zellij vivid tree-sitter-cli nvimpager
  zoxide git-delta lazygit
)
casks=(1password-cli)

installed="$(brew list --formula -1)"
missing=()
for p in "${packages[@]}"; do
  grep -qx "$p" <<<"$installed" || missing+=("$p")
done

if (( ${#missing[@]} )); then
  echo "Installing Homebrew packages: ${missing[*]}"
  brew install -q "${missing[@]}"
fi

installed_casks="$(brew list --cask -1)"
missing=()
for c in "${casks[@]}"; do
  grep -qx "$c" <<<"$installed_casks" || missing+=("$c")
done

if (( ${#missing[@]} )); then
  echo "Installing Homebrew casks: ${missing[*]}"
  brew install -q --cask "${missing[@]}"
fi
{{ end -}}
